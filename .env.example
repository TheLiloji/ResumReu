# ============================================================
# ResumReu — environment configuration
# Copy this file to `.env` and fill in the values.
# ============================================================

# --- Application ---
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_DATA_DIR=./data

# --- HuggingFace ---
# Required for gated models (pyannote/speaker-diarization-community-1, gemma-4)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Speech models ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
# int8_float16: int8 weights + float16 compute. Halves VRAM vs float16
# (large-v3 ≈ 1.6 GB instead of 3 GB) and avoids the
# CUBLAS_STATUS_NOT_SUPPORTED that pure float16 hits with cuBLAS 12.9 on Ada.
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_LANGUAGE=fr

PYANNOTE_PIPELINE=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cuda

# --- LLM (Gemma 4 E4B, tuned for 8 GB VRAM) ---
LLM_MODEL_ID=google/gemma-4-E4B-it
LLM_LOAD_IN_4BIT=true
LLM_DEVICE_MAP=cuda
LLM_CPU_OFFLOAD=false
LLM_MAX_GPU_MEMORY=6GiB
LLM_MAX_CPU_MEMORY=24GiB
LLM_OFFLOAD_FOLDER=./data/models/llm-offload
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.3

# --- Embeddings ---
EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DEVICE=cuda

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/vector_store
CHROMA_COLLECTION_MEETINGS=meetings
CHROMA_COLLECTION_CEGID_DOCS=cegid_docs

# --- Persistence ---
DATABASE_URL=sqlite:///./data/resumreu.db

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
